# Copy to .env and fill in. .env is git-ignored.
DATABASE_URL=postgresql+psycopg://txcat:txcat@localhost:5433/txcat
# Optional: a separate database used by the Postgres integration tests
TEST_DATABASE_URL=
KAGGLE_API_TOKEN=
# MLflow tracking store (default: local SQLite file mlflow.db, git-ignored)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Model served by the API: registry URI or a directory from `txcat export-model`
MODEL_URI=models:/txcat-categorizer@champion
